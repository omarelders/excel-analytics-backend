# ============================================================================
# Gold Road API — environment template
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. NEVER commit real credentials.
# ============================================================================

# --- Database (required) ----------------------------------------------------
# Postgres in production. Accepts postgres:// (auto-rewritten to postgresql://).
# Local development only:  sqlite:///./dev.db
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- Environment (required) -------------------------------------------------
# production  -> secure cookies, localhost CORS origins blocked
# development -> localhost CORS origins allowed
ENV=production

# --- CORS -------------------------------------------------------------------
# Comma-separated extra origins appended to the built-in allow-list.
# Blocked in production: localhost / 127.0.0.1 / loopback origins.
CORS_ORIGINS=

# --- Seed users (optional) --------------------------------------------------
# seed_users.py only creates a user when the matching password variable is set.
# If NONE of them are set, seeding is skipped entirely — no users are created.
#
# SEED_ADMIN_PASSWORD   -> seeds 'omar' and 'mariam' as admins (role='admin')
# SEED_OMAR_PASSWORD    -> seeds 'omar' only
# SEED_MARIAM_PASSWORD  -> seeds 'mariam' only
#
# Users that already exist are never overwritten. If migration 002 left an
# existing user with role='user', recover admin with:
#   python scripts/promote_admin.py <username>
SEED_ADMIN_PASSWORD=
SEED_OMAR_PASSWORD=
SEED_MARIAM_PASSWORD=
