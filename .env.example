# ============================================================================
# Gold Road API — environment template
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. NEVER commit real credentials.
# ============================================================================

# --- Database (required) ----------------------------------------------------
# Postgres in production. Accepts postgres:// (auto-rewritten to postgresql://).
# Local development only:  sqlite:///./dev.db
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- Environment (required) -------------------------------------------------
# production  -> secure cookies, localhost CORS origins blocked
# development -> localhost CORS origins allowed
ENV=production

# --- Reverse proxy topology (required in production) -------------------------
# How many reverse proxies append to X-Forwarded-For in front of the app, and
# are therefore trusted. The production chain is TWO hops: the Vercel edge that
# rewrites the request onto Heroku, and Heroku's own router - so:
#
#   2 -> production (browser -> Vercel rewrite -> Heroku router -> app)
#   1 -> clients reach Heroku's router directly, no Vercel in front
#   0 -> no proxy at all (local/direct exposure only)
#
# The login rate limiter is keyed on this. With 1 in the Vercel topology the
# key becomes the shared Vercel edge IP and the whole user base is throttled as
# one bucket; left unset under ENV=production the app refuses to start at all.
TRUSTED_PROXY_COUNT=2

# --- CORS -------------------------------------------------------------------
# Comma-separated extra origins appended to the built-in allow-list.
# Blocked in production: localhost / 127.0.0.1 / loopback origins.
CORS_ORIGINS=

# --- Seed users (optional) --------------------------------------------------
# seed_users.py only creates a user when the matching password variable is set.
# If NONE of them are set, seeding is skipped entirely — no users are created.
#
# SEED_ADMIN_PASSWORD   -> seeds 'omar' and 'mariam' as admins (role='admin')
# SEED_OMAR_PASSWORD    -> seeds 'omar' only
# SEED_MARIAM_PASSWORD  -> seeds 'mariam' only
#
# Users that already exist are never overwritten. If migration 002 left an
# existing user with role='user', recover admin with:
#   python scripts/promote_admin.py <username>
#
# Passwords are limited to 72 bytes - bcrypt hashes no more than that, so a
# longer one would be stored (and accepted at login) as its own 72-byte prefix.
# A longer SEED_*_PASSWORD is rejected with an error naming the variable, so a
# mistyped passphrase fails loudly instead of losing its extra characters.
SEED_ADMIN_PASSWORD=
SEED_OMAR_PASSWORD=
SEED_MARIAM_PASSWORD=
